{
  "mcpServers": {
    "mlflow-mcp": {
      "command": "uv",
      "args": ["run", "--with", "mlflow[mcp]>=3.5.1", "mlflow", "mcp", "run"],
      "env": {
        "MLFLOW_TRACKING_URI": "databricks",
        "DATABRICKS_CONFIG_PROFILE": "DEFAULT",
        "MLFLOW_MCP_TOOLS": "all"
      }
    }
  }
}
